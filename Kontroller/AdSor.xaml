<Window x:Class="DinamikAda.Kontroller.AdSor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Düzeni kaydet"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Background="#141418"
        Foreground="#F5F5F7" FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#F5F5F7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock x:Name="Aciklama" Foreground="#9A9AA3" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Açık pencerelerin yerleri bu adla saklanır; kısayol çubuğundaki düzen düğmesinden tek tıkla geri kurulur."/>
        <TextBox x:Name="Kutu" KeyDown="Kutu_KeyDown"/>
        <TextBlock x:Name="Ozet" Foreground="#9A9AA3" FontSize="11" Margin="0,8,0,0" Text=""/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="İptal" Click="Iptal_Click"/>
            <Button x:Name="TamamDugme" Content="Kaydet" Click="Tamam_Click" Background="#D97757" BorderBrush="#D97757" Foreground="#0B0B0F" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
