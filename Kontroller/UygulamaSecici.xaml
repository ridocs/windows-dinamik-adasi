<Window x:Class="DinamikAda.Kontroller.UygulamaSecici"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kısayol çubuğuna uygulama ekle"
        Width="440" Height="560" ResizeMode="CanResize" MinWidth="380" MinHeight="400"
        WindowStartupLocation="Manual" Background="#141418"
        Foreground="#F5F5F7" FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#F5F5F7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="K" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Background" Value="#1AFFFFFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="K" Property="Background" Value="#33D97757"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="Arama" TextChanged="Arama_TextChanged" ToolTip="Uygulama adı yazın"/>
            <TextBlock x:Name="AramaIpucu" IsHitTestVisible="False" Text="Uygulama ara…" Foreground="#6E6E78" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <ListBox x:Name="Liste" Grid.Row="1" Background="#0F0F13" BorderBrush="#22FFFFFF" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Liste_DoubleClick"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="7" Background="#14FFFFFF" Margin="0,0,10,0">
                            <Image Source="{Binding Simge}" Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Ad}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Tur}" FontSize="10.5" Foreground="#9A9AA3" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="Sayac" Foreground="#9A9AA3" FontSize="11" VerticalAlignment="Center" Text=""/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Dosyadan seç…" Click="Dosya_Click" ToolTip="Listede yoksa exe veya kısayol dosyası seçin"/>
                <Button Content="İptal" Click="Iptal_Click"/>
                <Button x:Name="EkleDugme" Content="Ekle" Click="Ekle_Click" Background="#F5F5F7" Foreground="#0B0B0F" FontWeight="SemiBold" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
