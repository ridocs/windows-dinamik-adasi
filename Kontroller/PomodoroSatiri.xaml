<UserControl x:Class="DinamikAda.Kontroller.PomodoroSatiri"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE916;"
                   Foreground="{StaticResource MetinIkincil}" VerticalAlignment="Center" Margin="4,0,8,0"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Sure" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MetinBirincil}" Text="25:00"/>
            <TextBlock x:Name="Durum" FontSize="10.5" Foreground="{StaticResource MetinIkincil}" Margin="8,0,0,0"
                       VerticalAlignment="Center" Text="odaklanma"/>
        </StackPanel>

        <Button x:Name="BaslatDugme" Grid.Column="2" Style="{StaticResource SimgeDugme}" Width="28" Height="28" FontSize="12"
                Content="&#xE768;" Click="Baslat_Click" ToolTip="Başlat / Duraklat"/>
        <Button Grid.Column="3" Style="{StaticResource SimgeDugme}" Width="28" Height="28" FontSize="12"
                Content="&#xE72C;" Click="Sifirla_Click" ToolTip="Sıfırla"/>
        <Button Grid.Column="4" Style="{StaticResource SimgeDugme}" Width="34" Height="28" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                Content="+5" Click="Ekle_Click" ToolTip="5 dakika ekle"/>
    </Grid>
</UserControl>
