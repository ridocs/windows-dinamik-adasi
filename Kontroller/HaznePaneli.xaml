<UserControl x:Class="DinamikAda.Kontroller.HaznePaneli"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KucukDugme" TargetType="Button" BasedOn="{StaticResource SimgeDugme}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Eşit genişlikli düğme: UniformGrid/dikey sütunda tam hücreye yayılır, sola yaslı ikon+metin -->
        <Style x:Key="EsitDugme" TargetType="Button" BasedOn="{StaticResource AltDugme}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="11,6"/>
        </Style>

        <!-- Liste satırı: hover zeminli, sağdaki eylemler hover'da belirir -->
        <DataTemplate x:Key="ListeSablon">
            <Border x:Name="Satir" Margin="0,0,0,4" Padding="6,5" CornerRadius="9" Background="Transparent" Cursor="Hand"
                    PreviewMouseLeftButtonDown="Oge_MouseDown" PreviewMouseMove="Oge_MouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="9" Background="#18FFFFFF" Margin="0,0,12,0">
                        <Image Source="{Binding Simge}" Width="24" Height="24" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Ad}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MetinBirincil}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding AltBilgi}" FontSize="10.5" Foreground="{StaticResource MetinIkincil}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="Eylemler" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                        <Button Style="{StaticResource KucukDugme}" Content="&#xE8F2;" ToolTip="Bu dosyayı Claude'a özetlet" Tag="{Binding}" Click="OgeClaude_Click"/>
                        <Button Style="{StaticResource KucukDugme}" Content="&#xE8EA;" ToolTip="Bu dosyayı telefona gönder" Tag="{Binding}" Click="OgeTelefon_Click"/>
                        <Button Style="{StaticResource KucukDugme}" Content="&#xE898;" ToolTip="Sunucuya yükle" Tag="{Binding}" Click="OgeYukle_Click"/>
                        <Button Style="{StaticResource KucukDugme}" Content="&#xE71B;" ToolTip="Yükle ve linki kopyala" Tag="{Binding}" Click="OgeLink_Click"/>
                        <Button Style="{StaticResource KucukDugme}" Content="&#xE74D;" ToolTip="Hazneden çıkar" Tag="{Binding}" Click="OgeSil_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Satir" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Satir" Property="Background" Value="#12FFFFFF"/>
                    <Setter TargetName="Eylemler" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Izgara kutucuğu -->
        <DataTemplate x:Key="IzgaraSablon">
            <Border x:Name="Kutu" Width="106" Height="96" Margin="0,0,8,8" CornerRadius="12" Background="#10FFFFFF" Cursor="Hand"
                    PreviewMouseLeftButtonDown="Oge_MouseDown" PreviewMouseMove="Oge_MouseMove">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="8,6">
                        <Image Source="{Binding Simge}" Width="40" Height="40" Stretch="Uniform"/>
                        <TextBlock Text="{Binding Ad}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MetinBirincil}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,7,0,0"/>
                        <TextBlock Text="{Binding AltBilgi}" FontSize="9" Foreground="{StaticResource MetinIkincil}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button x:Name="Sil" Style="{StaticResource KucukDugme}" Width="20" Height="20" FontSize="9" Content="&#xE711;" ToolTip="Hazneden çıkar" Opacity="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Tag="{Binding}" Click="OgeSil_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Kutu" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Kutu" Property="Background" Value="#1CFFFFFF"/>
                    <Setter TargetName="Sil" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="16,13,16,13">
        <!-- Başlık -->
        <Grid Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource KucukDugme}" Content="&#xE72B;" ToolTip="Saat ve kısayollara dön" Margin="0,0,10,0" Click="Geri_Click"/>
                <Path Data="M9.5,3.5 L4.6,8.4 A2.4,2.4 0 0 0 8,11.8 L12.6,7.2 A3.8,3.8 0 0 0 7.2,1.8 L2.8,6.2" Stroke="{StaticResource Vurgu}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="Baslik" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MetinBirincil}" VerticalAlignment="Center" Text="Hazne"/>
                <Border Background="#18FFFFFF" CornerRadius="9" Padding="7,1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Sayac" FontSize="11" Foreground="{StaticResource MetinIkincil}" Text="0"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="GorunumDugme" Style="{StaticResource KucukDugme}" Content="&#xF0E2;" ToolTip="Liste / ızgara" Margin="0,0,6,0" Click="Gorunum_Click"/>
                <Button Style="{StaticResource AltDugme}" Tag="&#xE77F;" Content="Panodan ekle" Margin="0" Click="Pano_Click" ToolTip="Panodaki dosya, görsel ya da metni hazneye ekler"/>
            </StackPanel>
        </Grid>

        <!-- İçerik: liste modunda sağda dikey eşit düğme sütunu; ızgara modunda tek geniş alan -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="YanSutun" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="Kaydirici" Grid.Column="0" MaxHeight="248" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource InceKaydirma}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="Liste"/>
            </ScrollViewer>
            <StackPanel x:Name="YanCubuk" Grid.Column="1" Width="120" Margin="10,0,0,0" VerticalAlignment="Top">
                <Button x:Name="ClaudeYan" Style="{StaticResource EsitDugme}" Margin="0,0,0,6" Tag="&#xE8F2;" Content="Claude" Click="Claude_Click" ToolTip="Metin dosyalarını Claude'a özetlet"/>
                <Button x:Name="TelefonYan" Style="{StaticResource EsitDugme}" Margin="0,0,0,6" Tag="&#xE8EA;" Content="Telefona" Click="Telefon_Click" ToolTip="WhatsApp köprüsüyle kendi numarana gönder"/>
                <Button x:Name="ZipYan" Style="{StaticResource EsitDugme}" Margin="0,0,0,6" Tag="&#xE7B8;" Content="Zip" Click="Zip_Click" ToolTip="Masaüstünde tek zip'e topla"/>
                <Button x:Name="LinkYan" Style="{StaticResource EsitDugme}" Margin="0,0,0,6" Tag="&#xE71B;" Content="Link" Click="Link_Click" ToolTip="Herkese açık klasöre yükle, linkleri kopyala"/>
                <Button x:Name="YukleYan" Style="{StaticResource EsitDugme}" Margin="0,0,0,6" Tag="&#xE898;" Content="Yükle" Click="Yukle_Click" ToolTip="Sunucuya yükle"/>
                <Button x:Name="TemizleYan" Style="{StaticResource EsitDugme}" Margin="0" Tag="&#xE74D;" Content="Temizle" Click="Temizle_Click" ToolTip="Hazneyi boşalt (dosyalar diskte kalır)"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Bos" FontSize="12" Foreground="{StaticResource MetinIkincil}" TextAlignment="Center" Text="Hazne boş. Dosyayı kapsülün üstüne bırakın ya da Ctrl+V ile yapıştırın." Margin="0,10,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>

        <!-- Izgara görünümünde altta eşit genişlikli düğmeler; sütun sayısı koddan (kapsül genişliğine göre 3-3 / 2-2-2) -->
        <Border x:Name="AltAyrac" Height="1" Background="#12FFFFFF" Margin="0,10,0,0" Visibility="Collapsed"/>
        <UniformGrid x:Name="AltCubuk" Columns="3" Margin="0,8,0,0" Visibility="Collapsed">
            <Button x:Name="ClaudeDugme" Style="{StaticResource EsitDugme}" Tag="&#xE8F2;" Content="Claude" Click="Claude_Click" ToolTip="Metin dosyalarını Claude'a özetlet"/>
            <Button x:Name="TelefonDugme" Style="{StaticResource EsitDugme}" Tag="&#xE8EA;" Content="Telefona" Click="Telefon_Click" ToolTip="WhatsApp köprüsüyle kendi numarana gönder"/>
            <Button x:Name="ZipDugme" Style="{StaticResource EsitDugme}" Tag="&#xE7B8;" Content="Zip" Click="Zip_Click" ToolTip="Masaüstünde tek zip'e topla"/>
            <Button x:Name="LinkDugme" Style="{StaticResource EsitDugme}" Tag="&#xE71B;" Content="Link" Click="Link_Click" ToolTip="Herkese açık klasöre yükle, linkleri kopyala"/>
            <Button x:Name="YukleDugme" Style="{StaticResource EsitDugme}" Tag="&#xE898;" Content="Yükle" Click="Yukle_Click" ToolTip="Sunucuya yükle"/>
            <Button x:Name="TemizleDugme" Style="{StaticResource EsitDugme}" Tag="&#xE74D;" Content="Temizle" Click="Temizle_Click" ToolTip="Hazneyi boşalt (dosyalar diskte kalır)"/>
        </UniformGrid>
        <TextBlock x:Name="Ipucu" FontSize="9.5" Foreground="#6E6E78" TextAlignment="Center" Text="Ctrl+V yapıştırır · sürükle: taşır · Ctrl: kopyalar · Alt: kısayol" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
