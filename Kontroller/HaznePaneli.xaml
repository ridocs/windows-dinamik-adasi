<UserControl x:Class="DinamikAda.Kontroller.HaznePaneli"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KucukDugme" TargetType="Button" BasedOn="{StaticResource SimgeDugme}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Liste satırı -->
        <DataTemplate x:Key="ListeSablon">
            <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand"
                  PreviewMouseLeftButtonDown="Oge_MouseDown" PreviewMouseMove="Oge_MouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="7" Background="#14FFFFFF" Margin="0,0,10,0">
                    <Grid>
                        <Image Source="{Binding Simge}" Stretch="UniformToFill" Margin="3"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Ad}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MetinBirincil}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AltBilgi}" FontSize="10.5" Foreground="{StaticResource MetinIkincil}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource KucukDugme}" Content="&#xE898;" ToolTip="Sunucuya yükle" Tag="{Binding}" Click="OgeYukle_Click"/>
                    <Button Style="{StaticResource KucukDugme}" Content="&#xE71B;" ToolTip="Yükle ve linki kopyala" Tag="{Binding}" Click="OgeLink_Click"/>
                    <Button Style="{StaticResource KucukDugme}" Content="&#xE711;" ToolTip="Hazneden çıkar" Tag="{Binding}" Click="OgeSil_Click"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Izgara kutucuğu -->
        <DataTemplate x:Key="IzgaraSablon">
            <Border Width="108" Height="92" Margin="0,0,8,8" CornerRadius="10" Background="#12FFFFFF" Cursor="Hand"
                    PreviewMouseLeftButtonDown="Oge_MouseDown" PreviewMouseMove="Oge_MouseMove">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="6,4">
                        <Image Source="{Binding Simge}" Width="40" Height="40" Stretch="Uniform"/>
                        <TextBlock Text="{Binding Ad}" FontSize="11" Foreground="{StaticResource MetinBirincil}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding AltBilgi}" FontSize="9.5" Foreground="{StaticResource MetinIkincil}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource KucukDugme}" Width="20" Height="20" FontSize="9" Content="&#xE711;" ToolTip="Hazneden çıkar"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Tag="{Binding}" Click="OgeSil_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="16,12,16,12">
        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource KucukDugme}" Content="&#xE72B;" ToolTip="Saat ve kısayollara dön" Margin="0,0,6,0" Click="Geri_Click"/>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE723;" Foreground="{StaticResource Vurgu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="Baslik" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MetinBirincil}" Text="Hazne"/>
                <TextBlock x:Name="Sayac" FontSize="11.5" Foreground="{StaticResource MetinIkincil}" Margin="8,0,0,0" VerticalAlignment="Center" Text=""/>
            </StackPanel>
            <Button Style="{StaticResource AltDugme}" Tag="&#xE77F;" Content="Panodan ekle" HorizontalAlignment="Right" Click="Pano_Click" ToolTip="Panodaki dosya, görsel ya da metni hazneye ekler"/>
        </Grid>

        <ScrollViewer x:Name="Kaydirici" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource InceKaydirma}"/>
            </ScrollViewer.Resources>
            <ItemsControl x:Name="Liste"/>
        </ScrollViewer>

        <TextBlock x:Name="Bos" FontSize="11.5" Foreground="{StaticResource MetinIkincil}" Text="Hazne boş. Dosyayı kapsülün üstüne bırakın." Margin="0,4,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="ClaudeDugme" Style="{StaticResource AltDugme}" Tag="&#xE8F2;" Content="Claude" Click="Claude_Click" ToolTip="Haznedeki metin dosyalarını Claude'a özetlet"/>
            <Button x:Name="TelefonDugme" Style="{StaticResource AltDugme}" Tag="&#xE8EA;" Content="Telefona" Click="Telefon_Click" ToolTip="Haznedekileri WhatsApp köprüsüyle kendi numarana gönder"/>
            <Button x:Name="EpostaDugme" Style="{StaticResource AltDugme}" Tag="&#xE715;" Content="E-posta" Click="Eposta_Click" ToolTip="Varsayılan posta uygulamasında ek olarak aç"/>
            <Button x:Name="ZipDugme" Style="{StaticResource AltDugme}" Tag="&#xE7B8;" Content="Zip" Click="Zip_Click" ToolTip="Haznedekileri masaüstünde tek zip'e topla"/>
            <Button x:Name="LinkDugme" Style="{StaticResource AltDugme}" Tag="&#xE71B;" Content="Link" Click="Link_Click" ToolTip="Hepsini herkese açık klasöre yükle, linkleri panoya kopyala"/>
            <Button x:Name="YukleDugme" Style="{StaticResource AltDugme}" Tag="&#xE898;" Content="Yükle" Click="Yukle_Click" ToolTip="Hepsini sunucuya yükle"/>
            <Button x:Name="TemizleDugme" Style="{StaticResource AltDugme}" Tag="&#xE74D;" Content="Temizle" Click="Temizle_Click" ToolTip="Hazneyi boşalt (dosyalar diskte kalır)"/>
        </StackPanel>
        <TextBlock x:Name="Ipucu" FontSize="9.5" Foreground="#6E6E78" Text="Ctrl+V panodan yapıştırır · sürükle: taşır · Ctrl: kopyalar · Alt: kısayol" HorizontalAlignment="Right" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
